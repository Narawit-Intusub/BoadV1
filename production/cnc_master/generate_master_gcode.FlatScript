# ==============================================================================
# FlatCAM Automation Script for Master Board (TCL Script)
# โครงการ: Modular Smart Board Game V1 - Master Board
# ==============================================================================
# คำแนะนำการใช้งาน:
# 1. เปิดโปรแกรม FlatCAM
# 2. ไปที่เมนู File -> Run Script (หรือกด Ctrl + Shift + R)
# 3. เลือกไฟล์นี้ (generate_master_gcode.FlatScript)
# ระบบจะ Generate ไฟล์ G-code ครบทุกเลเยอร์แล้วเซฟลงโฟลเดอร์ gcode/ อัตโนมัติทันที
# ==============================================================================

set base_dir "F:/board game/production/cnc_master"
set out_dir "F:/board game/production/cnc_master/gcode"

# 1. ประมวลผลเลเยอร์ลายทองแดงหน้าบน (F_Cu)
open_gerber "$base_dir/master-F_Cu.gtl" -outname master_top
isolate master_top -dia 0.1 -passes 1 -overlap 10 -combine 1 -outname master_top_iso
cncjob master_top_iso -dia 0.1 -z_cut -0.05 -z_move 2.0 -feedrate 120.0 -feedrate_z 60.0 -spindlespeed 1200 -outname master_top_cnc
write_gcode master_top_cnc "$out_dir/master_top_iso.nc"

# 2. ประมวลผลเลเยอร์ลายทองแดงหน้าล่าง (B_Cu - Mirror แกน X)
open_gerber "$base_dir/master-B_Cu.gbl" -outname master_bot
mirror master_bot -axis X -box master_top
isolate master_bot -dia 0.1 -passes 1 -overlap 10 -combine 1 -outname master_bot_iso
cncjob master_bot_iso -dia 0.1 -z_cut -0.05 -z_move 2.0 -feedrate 120.0 -feedrate_z 60.0 -spindlespeed 1200 -outname master_bot_cnc
write_gcode master_bot_cnc "$out_dir/master_bot_iso.nc"

# 3. ประมวลผลรูเจาะ (PTH Drills)
open_excellon "$base_dir/master-PTH.drl" -outname master_drill
drillcncjob master_drill -drillz -1.8 -travelz 2.0 -feedrate_z 120.0 -spindlespeed 1200 -outname master_drill_cnc
write_gcode master_drill_cnc "$out_dir/master_drills.nc"

# 4. ประมวลผลตัดขอบแผ่น (Edge Cuts)
open_gerber "$base_dir/master-Edge_Cuts.gm1" -outname master_edge
cutout master_edge -dia 1.0 -margin 0.0 -gapsize 2.0 -gaps 4 -outname master_cutout_geom
cncjob master_cutout_geom -dia 1.0 -z_cut -1.8 -z_move 2.0 -feedrate 120.0 -feedrate_z 60.0 -spindlespeed 1200 -dpp 0.45 -outname master_cutout_cnc
write_gcode master_cutout_cnc "$out_dir/master_cutout.nc"

